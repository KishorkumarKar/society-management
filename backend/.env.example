# ==========================================================
# Society Management API — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to source control.
# ==========================================================

# --- App ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=society_app
DB_PASSWORD=change_me
DB_DATABASE=society_management
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=10

# --- JWT ---
# Generate strong random secrets, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_min_64_chars
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=society-management-api

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=12

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# --- ACL permission cache ---
ACL_CACHE_TTL_SECONDS=300

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs

# --- Dev-only seed credentials (never use in production) ---
SEED_DEFAULT_PASSWORD=Password@123
